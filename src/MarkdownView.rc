// MarkdownView.rc - embedded help text and version information
#include <winver.h>
#include "resource.h"

// README.md is found through the include path (project root): see CMakeLists.txt / Makefile.mingw
IDR_HELP_MD RCDATA "README.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TcWlxMarkdownViewAir - Markdown viewer for Total Commander (Lister plugin)"
            VALUE "FileVersion", "1.3.0"
            VALUE "InternalName", "TcWlxMarkdownViewAir"
            VALUE "OriginalFilename", "TcWlxMarkdownViewAir.wlx"
            VALUE "ProductName", "TcWlxMarkdownViewAir"
            VALUE "ProductVersion", "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
